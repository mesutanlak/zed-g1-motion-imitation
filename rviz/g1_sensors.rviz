Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0.15
      Enabled: true
      Name: Livox Mid-360
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Value: /livox/lidar
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 60; 200; 255
      Color Transformer: FlatColor
      Decay Time: 0.15
      Enabled: true
      Name: D435i Depth Points
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Value: /camera/camera/depth/color/points
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: G1 Robot Mesh
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /g1/robot_mesh
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: D435i Depth Image
      Normalize Range: true
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Value: /camera/camera/depth/image_rect_raw
  Enabled: true
  Global Options:
    Background Color: 36; 36; 36
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Name: Current View
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Yaw: 5.4
